{
  "id": "./",
  "name": "Rimay Studio",
  "short_name": "Rimay",
  "description": "Editor de audio multipista para aprender a producir con sonido: graba, edita, mezcla y exporta en WAV o MP3, sin cuentas ni nube. · Multitrack audio editor for learning audio production: record, edit, mix and export WAV or MP3, with no accounts and no cloud.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#121417",
  "theme_color": "#121417",
  "categories": ["music", "education", "productivity"],
  "icons": [
    { "src": "icono-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icono-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icono-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "name": "Rimay Studio project / Proyecto de Rimay Studio",
      "accept": { "application/x-rimay-project": [".rimay"], "application/x-audiolab-project": [".audiolab"] },
      "icons": [{ "src": "icono-proyecto-256.png", "sizes": "256x256", "type": "image/png" }],
      "launch_type": "single-client"
    }
  ]
}
